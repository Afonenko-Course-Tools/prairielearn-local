# Базовая инфраструктура запускается и без .env; здесь только необязательные настройки.
COMPOSE_PROJECT_NAME=prairielearn-local
PL_IMAGE=ghcr.io/afonenko-course-tools/prairielearn-community-gateway:2.5.8
NGINX_IMAGE=docker.io/library/nginx@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
POSTGRES_IMAGE=postgres:17
STATE_DIR=./state
# Docker Compose сам раскрывает PWD; собственного .env parser нет.
HOST_JOBS_DIR=${PWD}/state/jobs
BIND_IP=127.0.0.1
PL_HOST=pl.infra.localhost
PL_HTTPS_PORT=19444
MOODLE_HOST=moodle.infra.localhost
MOODLE_HTTPS_PORT=19443
BOOTSTRAP_ADMIN_UID=servicebootstrap@local.invalid
